# Copier en .env.local (non versionné). Jamais de clé Supabase « secret » ni
# « service_role » dans le back-office (ADR-011).
SUPABASE_URL=https://<projet>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Facultatif : adresse HTTPS des enregistrements (Backblaze B2).
AUDIO_BASE_URL=
# Facultatif, SECRET : clé Backblaze limitée au compartiment audio (envoi direct
# depuis la fiche d'un cantique, docs/deployment/audio-backblaze.md §1 bis).
B2_KEY_ID=
B2_APPLICATION_KEY=
