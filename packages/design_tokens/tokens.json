      "background": "#FFFFFF",
      "surface": "#FAFAF8",
      "hairline": "#ECE8E2",
      "text": "#1F1A17",
      "textSecondary": "#6B625B",
      "gold": "#B08D57",
      "goldText": "#8A6A35",
      "error": "#9B2C2C",
      "success": "#3F6B4A",
      "info": "#4F5F68"
    },
    "dark": {
      "background": "#121110",
      "surface": "#1B1A18",
      "hairline": "#2C2925",
      "text": "#F2EEE8",
      "textSecondary": "#A89F96",
      "gold": "#C9A46B",
      "goldText": "#D4B27A",
      "error": "#E38B8B",
      "success": "#8FC39C",
      "info": "#9FB2BC"
    },
    "projection": {
      "background": "#000000",
      "surface": "#000000",
      "hairline": "#262626",
      "text": "#FFFFFF",
      "textSecondary": "#BDBDBD",
      "gold": "#C9A46B",
      "goldText": "#D4B27A",
      "error": "#E38B8B",
      "success": "#8FC39C",
      "info": "#9FB2BC"
    }
  },
  "contrast": {
    "$description": "Exigences vérifiées par test (WCAG 2.x). Les paroles exigent AAA.",
    "rules": [
      {
        "foreground": "text",
        "background": "background",
        "min": 7
      },
      {
        "foreground": "text",
        "background": "surface",
        "min": 7
      },
      {
        "foreground": "textSecondary",
        "background": "background",
        "min": 4.5
      },
      {
        "foreground": "textSecondary",
        "background": "surface",
        "min": 4.5
      },
      {
        "foreground": "goldText",
        "background": "background",
