{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "numberLabel": {
      "type": "string",
      "pattern": "^[1-9]\\d{0,3}(bis|ter)?$"
    },
    "numberNumeric": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9999
    },
    "numberSuffix": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "bis",
            "ter"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "openingLine": {
      "type": [
        "string",
        "null"
      ]
    },
    "languageCode": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "type": {
            "type": "string",
            "enum": [
              "verse",
              "refrain",
              "bridge",
              "intro",
              "outro",
              "note"
            ]
          },
          "number": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lines": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "repeat": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer",
                          "minimum": 2,
                          "maximum": 12
                        },
                        "marker": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "count",
                        "marker"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "text",
                "repeat"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "type",
          "number",
          "order",
          "lines"
        ],
        "additionalProperties": false
      }
    },
    "bibleReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "displayText": {
            "type": "string"
          },
          "book": {
            "type": [
              "string",
              "null"
            ]
          },
          "chapterStart": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "verseStart": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "chapterEnd": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "verseEnd": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "displayText",
          "book",
          "chapterStart",
          "verseStart",
          "chapterEnd",
          "verseEnd"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "same_melody",
              "variant",
              "bis_of",
              "related"
            ]
          },
          "relatedHymnId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "type",
          "relatedHymnId"
        ],
        "additionalProperties": false
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "author",
              "composer",
              "translator",
              "arranger"
            ]
          },
          "fullName": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "fullName"
        ],
        "additionalProperties": false
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audio": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "melody",
              "accompaniment",
              "choir",
              "soprano",
              "alto",
              "tenor",
              "bass",
              "instrumental",
              "other"
            ]
          },
          "storageKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.(mp3|m4a|aac)$"
          },
          "durationSeconds": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sectionId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lineIndex": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "startMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endMs": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "order": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "sectionId",
                "startMs",
                "endMs",
                "order"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "mediaType",
          "storageKey",
          "durationSeconds",
          "segments"
        ],
        "additionalProperties": false
      }
    },
    "videos": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "melody",
              "accompaniment",
              "choir",
              "soprano",
              "alto",
              "tenor",
              "bass",
              "instrumental",
              "other"
            ]
          },
          "youtubeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "mediaType",
          "youtubeId",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "numberLabel",
    "numberNumeric",
    "numberSuffix",
    "title",
    "openingLine",
    "languageCode",
    "sections",
    "bibleReferences",
    "relations",
    "people",
    "themes"
  ],
  "additionalProperties": false
}
