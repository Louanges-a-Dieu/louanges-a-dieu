  "fixed_sql": [
    {
      "name": "hymn_search",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE VIRTUAL TABLE IF NOT EXISTS \"hymn_search\" USING fts5(hymn_id UNINDEXED, number, title, lyrics, tokenize = 'unicode61 remove_diacritics 2');"
        }
      ]
    },
    {
      "name": "catalog_hymns",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"catalog_hymns\" (\"id\" TEXT NOT NULL, \"number_label\" TEXT NOT NULL, \"number_numeric\" INTEGER NOT NULL, \"number_suffix\" TEXT NULL, \"title\" TEXT NOT NULL, \"opening_line\" TEXT NULL, \"sort_key\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "favorites",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favorites\" (\"hymn_id\" TEXT NOT NULL, \"is_favorite\" INTEGER NOT NULL CHECK (\"is_favorite\" IN (0, 1)), \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"hymn_id\"));"
        }
      ]
    },
    {
      "name": "playlists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"updated_at\" TEXT NOT NULL, \"server_revision\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "playlist_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlist_items\" (\"playlist_id\" TEXT NOT NULL REFERENCES playlists (id) ON DELETE CASCADE, \"hymn_id\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"playlist_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "worship_services",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"worship_services\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"service_date\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'draft', \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"updated_at\" TEXT NOT NULL, \"server_revision\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "worship_service_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"worship_service_items\" (\"id\" TEXT NOT NULL, \"service_id\" TEXT NOT NULL REFERENCES worship_services (id) ON DELETE CASCADE, \"hymn_id\" TEXT NULL, \"label\" TEXT NULL, \"notes\" TEXT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"entity\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 1, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"last_error\" TEXT NULL, \"updated_at\" TEXT NOT NULL, UNIQUE (\"entity\", \"entity_id\"));"
        }
      ]
    },
    {
      "name": "sync_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_state\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]
