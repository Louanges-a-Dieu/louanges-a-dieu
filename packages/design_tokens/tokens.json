{
  "$description": "Source unique du design system Louanges à Dieu (ADR-014). Direction : blanc, pur, épuré (Q-11). Ne jamais dupliquer ces valeurs dans le code des applications.",
  "color": {
    "light": {
      "background": "#FFFFFF",
      "surface": "#FAFAF8",
      "hairline": "#ECE8E2",
      "text": "#1F1A17",
      "textSecondary": "#6B625B",
      "gold": "#B08D57",
      "goldText": "#8A6A35",
      "error": "#9B2C2C",
      "success": "#3F6B4A",
      "info": "#4F5F68"
    },
    "dark": {
      "background": "#121110",
      "surface": "#1B1A18",
      "hairline": "#2C2925",
      "text": "#F2EEE8",
      "textSecondary": "#A89F96",
      "gold": "#C9A46B",
      "goldText": "#D4B27A",
      "error": "#E38B8B",
      "success": "#8FC39C",
      "info": "#9FB2BC"
    },
    "projection": {
      "background": "#000000",
      "surface": "#000000",
      "hairline": "#262626",
      "text": "#FFFFFF",
      "textSecondary": "#BDBDBD",
      "gold": "#C9A46B",
      "goldText": "#D4B27A",
      "error": "#E38B8B",
      "success": "#8FC39C",
      "info": "#9FB2BC"
    }
  },
  "contrast": {
    "$description": "Exigences vérifiées par test (WCAG 2.x). Les paroles exigent AAA.",
    "rules": [
      {
        "foreground": "text",
        "background": "background",
        "min": 7
      },
      {
        "foreground": "text",
        "background": "surface",
        "min": 7
      },
      {
        "foreground": "textSecondary",
        "background": "background",
        "min": 4.5
      },
      {
        "foreground": "textSecondary",
        "background": "surface",
        "min": 4.5
      },
      {
        "foreground": "goldText",
        "background": "background",
        "min": 4.5
      },
      {
        "foreground": "gold",
        "background": "background",
        "min": 3
      },
      {
        "foreground": "error",
        "background": "background",
        "min": 4.5
      },
      {
        "foreground": "success",
        "background": "background",
        "min": 4.5
      },
      {
        "foreground": "info",
        "background": "background",
        "min": 4.5
      }
    ]
  },
  "font": {
    "family": {
      "display": "Cormorant Garamond",
      "lyrics": "Literata",
      "ui": "Inter"
    },
    "fallback": {
      "display": "Georgia, serif",
      "lyrics": "Georgia, serif",
      "ui": "system-ui, sans-serif"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "typeScale": {
    "display": {
      "family": "display",
      "size": 40,
      "lineHeight": 1.1,
      "weight": "medium"
    },
    "hymnNumber": {
      "family": "display",
      "size": 32,
      "lineHeight": 1.1,
      "weight": "semibold"
    },
    "title": {
      "family": "display",
      "size": 26,
      "lineHeight": 1.2,
      "weight": "semibold"
    },
    "listNumber": {
      "family": "display",
      "size": 20,
      "lineHeight": 1.2,
      "weight": "semibold"
    },
    "headline": {
      "family": "ui",
      "size": 20,
      "lineHeight": 1.3,
      "weight": "semibold"
    },
    "lyrics": {
      "family": "lyrics",
      "size": 20,
      "lineHeight": 1.55,
      "weight": "regular"
    },
    "body": {
      "family": "ui",
      "size": 16,
      "lineHeight": 1.5,
      "weight": "regular"
    },
    "label": {
      "family": "ui",
      "size": 14,
      "lineHeight": 1.4,
      "weight": "medium"
    },
    "caption": {
      "family": "ui",
      "size": 12,
      "lineHeight": 1.4,
      "weight": "regular"
    }
  },
  "lyricsSize": {
    "$description": "Taille de lecture réglable par l'utilisateur (pt).",
    "min": 16,
    "default": 20,
    "max": 34,
    "step": 2
  },
  "space": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48,
    "huge": 64
  },
  "radius": {
    "none": 0,
    "sm": 4,
    "md": 8,
    "lg": 12,
    "pill": 999
  },
  "stroke": {
    "hairline": 1,
    "refrainRule": 2
  },
  "duration": {
    "fast": 120,
    "base": 200,
    "slow": 320
  },
  "touchTarget": {
    "min": 48
  }
}
