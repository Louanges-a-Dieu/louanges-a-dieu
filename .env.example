# Copier en .env.local (web) — ne jamais commiter de valeurs réelles.
# Les valeurs locales sont affichées par `supabase start`.

# --- Supabase (clés PUBLIQUES uniquement côté client) -------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Interdit dans toute application cliente ----------------------------------
# SUPABASE_SERVICE_ROLE_KEY : ne doit JAMAIS apparaître ici ni dans une app (ADR-011).
