  "contrast": {
    "$description": "Exigences vérifiées par test (WCAG 2.x). Les paroles exigent AAA. goldText sur goldPale : grands numéros uniquement (≥ 3).",
    "rules": [
      {
        "foreground": "text",
        "background": "background",
        "min": 7
      },
      {
        "foreground": "text",
        "background": "surface",
        "min": 7
      },
      {
        "foreground": "textSecondary",
        "background": "background",
        "min": 4.5
      },
      {
        "foreground": "textSecondary",
        "background": "surface",
        "min": 4.5
      },
      {
        "foreground": "goldText",
        "background": "background",
        "min": 4.5
      },
      {
        "foreground": "gold",
        "background": "background",
        "min": 3
      },
      {
        "foreground": "error",
        "background": "background",
        "min": 4.5
      },
      {
        "foreground": "success",
        "background": "background",
        "min": 4.5
      },
      {
        "foreground": "info",
        "background": "background",
        "min": 4.5
      },
      {
        "foreground": "text",
        "background": "surfaceWarm",
        "min": 7
      },
      {
        "foreground": "text",
        "background": "goldPale",
        "min": 7
      },
      {
        "foreground": "textSecondary",
        "background": "surfaceWarm",
        "min": 4.5
      },
      {
        "foreground": "goldText",
        "background": "surface",
        "min": 4.5
      },
      {
