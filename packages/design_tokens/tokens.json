      },
      {
        "foreground": "gold",
        "background": "background",
        "min": 3
      },
      {
        "foreground": "error",
        "background": "background",
        "min": 4.5
      },
      {
        "foreground": "success",
        "background": "background",
        "min": 4.5
      },
      {
        "foreground": "info",
        "background": "background",
        "min": 4.5
      }
    ]
  },
